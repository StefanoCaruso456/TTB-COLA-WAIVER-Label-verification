# Railway Postgres connection string. Required for verification history +
# batch endpoints.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gemini API key for real OCR/vision. Required unless USE_MOCK_EXTRACTION=true.
GEMINI_API_KEY=

# When true, the mock extractor is used instead of Gemini. Useful for local
# demo without a Gemini key. Production deploys should leave this unset.
USE_MOCK_EXTRACTION=true

# Gemini model id used by the Gemini extraction service.
GEMINI_MODEL=gemini-2.5-flash

# Resize uploaded label images and re-encode as JPEG (q=85) before sending to
# Gemini. Cuts payload ~85% on typical phone photos. Set to "false" to
# disable. Skipped automatically when using the mock extractor.
IMAGE_PREPROCESS_ENABLED=true

# Longest-edge target (pixels) after resize. Default 1024 sits at the bottom
# of Gemini's effective vision range (1024-1568) — saves ~30% on the Gemini
# call vs. 1280. Raise to 1280-1568 if your corpus has small print that
# benefits from extra resolution. Clamped 256..4096.
IMAGE_MAX_EDGE_PX=1024

# When true, the Gemini service logs the first 2 KB of every raw response.
# Operator-only diagnostic; leave unset in production.
EXTRACTION_DEBUG_LOG=false

# Root directory where batch label files are stored. Local dev: a project-local
# folder (gitignored). Production: point at a mounted Railway Volume path
# (e.g. /data/batch-files). The disk-storage layer creates subdirectories as
# needed.
BATCH_FILE_STORAGE_PATH=./.local/batch-files

# --- Phase 5: async batch worker ---

# Max bytes accepted by POST /api/batches. Default 200 MB, sized for the
# Phase 5 cap of 200 files × ~1 MB each.
BATCH_MAX_REQUEST_BYTES=209715200

# Max files per batch. Default 200, hard ceiling 500.
MAX_BATCH_FILES_OVERRIDE=200

# Parallel Gemini calls per batch in the worker. Clamped 1..10.
BATCH_WORKER_CONCURRENCY=3

# Global queued+processing count above which POST returns 429.
BATCH_QUEUE_DEPTH_LIMIT=500

# --- Braintrust telemetry (optional) ---

# When set, every /api/verify and /api/batches verification emits a parent
# `verify` span and a `gemini.extract` child span with latency, cost, token,
# and scoring metrics. Unset = lazy no-op; nothing leaks.
BRAINTRUST_API_KEY=

# Project name in Braintrust. Defaults to "ttb-cola-verifier".
BRAINTRUST_PROJECT=ttb-cola-verifier

# Cost-estimate rates for `gemini.extract` span. Defaults reflect public
# gemini-2.5-flash pricing per 1M tokens. Override if rates change so the
# cost metric stays accurate without a redeploy.
GEMINI_INPUT_USD_PER_M=0.30
GEMINI_OUTPUT_USD_PER_M=2.50
