# Railway Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gemini API key for real OCR/vision. Optional when USE_MOCK_EXTRACTION=true.
GEMINI_API_KEY=

# When true, the mock extractor is used instead of Gemini. Set to "true" for
# demo reliability even without a Gemini key.
USE_MOCK_EXTRACTION=true

# Maximum number of label images per verification.
MAX_LABEL_IMAGES=10

# Gemini model id used by the Gemini extraction service.
GEMINI_MODEL=gemini-2.5-flash
